# Experimental device package used to build the kernel for this project with
# pmbootstrap. deviceinfo_flash_method is "none" ON PURPOSE: pmbootstrap must never
# flash this phone. The boot image is assembled by tools/build-boot-image.py.
maintainer="Local experimental build <local-build@example.invalid>"
pkgname=device-xiaomi-pissarro
pkgver=0.1
pkgrel=0
pkgdesc="Redmi Note 11 Pro MT6877 - experimental headless port"
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="postmarketos-base linux-xiaomi-pissarro mkbootimg"
makedepends="devicepkg-dev"
source="deviceinfo kernel-cmdline.conf"

build() {
	devicepkg_build "$startdir" "$pkgname"
}

package() {
	devicepkg_package "$startdir" "$pkgname"
}

